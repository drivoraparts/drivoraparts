{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drivoraparts",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "drivoraparts.com", "custom_domain": true }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "drivoraparts"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "NEXT_PUBLIC_META_PIXEL_ID": "1275857431290062",
    "NEXT_PUBLIC_TIKTOK_PIXEL_ID": "D934B6JC77UB3EFMUH9G",
    "NEXT_PUBLIC_CF_IMAGE_OPTIMIZATION": "false",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-0L7W7RV3T2",
    "NEXT_PUBLIC_GTM_CONTAINER_ID": "GTM-N97B62HN"
  }
}
